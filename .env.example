# =============================================================================
# TruePose AI — secrets reference (DO NOT put real values in the repo)
# These are set as CLOUDFLARE WORKER SECRETS via:
#     cd worker && npx wrangler secret put <NAME>
# =============================================================================

# Google Generative Language API key (images via Gemini Flash, video via Veo)
GEMINI_API_KEY=

# Supabase project URL, e.g. https://abcdxyz.supabase.co
SUPABASE_URL=

# Supabase service_role key (server-side only — bypasses RLS; NEVER in browser)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret (Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# The FRONTEND (public/js/config.js) uses only these PUBLIC values (not secrets):
#   SUPABASE_URL, SUPABASE_ANON_KEY, API_BASE (your Worker URL)
# -----------------------------------------------------------------------------
